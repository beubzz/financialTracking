generator client {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  emailVerified DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  months       FinancialMonth[]
  goals        Goal[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model FinancialMonth {
  id         String        @id @default(cuid())
  month      DateTime
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    MoneyEntry[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, month])
  @@index([userId, month])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model MoneyEntry {
  id          String         @id @default(cuid())
  label       String
  amount      Decimal        @db.Decimal(12, 2)
  type        EntryType
  category    String?
  note        String?
  occurredAt DateTime?
  isRecurring Boolean        @default(false)
  recurrence  Recurrence     @default(MONTH)
  section     EntrySection   @default(MANDATORY)
  monthId     String
  month       FinancialMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([monthId, type])
  @@unique([monthId, label])
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  target      Decimal  @db.Decimal(12, 2)
  saved       Decimal  @default(0) @db.Decimal(12, 2)
  targetDate  DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, targetDate])
}

enum EntryType {
  INCOME
  EXPENSE
}

enum Recurrence {
  WEEK
  MONTH
  YEAR
}

enum EntrySection {
  MANDATORY
  PLEASURE
  VARIABLE
}
